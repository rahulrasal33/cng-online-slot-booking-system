    <servlet-class>CngBooking.PumpDataServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PumpDataServlet</servlet-name>
    <url-pattern>/getPumps</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PumpOrders</servlet-name>
    <servlet-class>CngBooking.PumpOrders</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PumpOrders</servlet-name>
