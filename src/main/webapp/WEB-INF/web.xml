  </servlet>
  <servlet-mapping>
    <servlet-name>StationAvailabilityServlet</servlet-name>
    <url-pattern>/getStationAvailability</url-pattern>
  </servlet-mapping>

  <!-- ✅ FIX: Added missing UserOrders servlet -->
  <servlet>
    <servlet-name>UserOrders</servlet-name>
    <servlet-class>CngBooking.UserOrders</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UserOrders</servlet-name>
    <url-pattern>/UserOrders</url-pattern>
  </servlet-mapping>

  <!-- ✅ FIX: Added missing LogoutServlet -->
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>CngBooking.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/LogoutServlet</url-pattern>
  </servlet-mapping>

  <!-- ✅ FIX: Added missing ChatServlet -->
  <servlet>
    <servlet-name>ChatServlet</servlet-name>
    <servlet-class>CngBooking.ChatServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ChatServlet</servlet-name>
    <url-pattern>/ChatServlet</url-pattern>
  </servlet-mapping>

  <!-- ==================== FILTERS ==================== -->

  <!-- JWT Authentication Filter -->
  <filter>
    <filter-name>JWTAuthFilter</filter-name>
    <filter-class>CngBooking.JWTAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>JWTAuthFilter</filter-name>
    <url-pattern>/UserDash/*</url-pattern>
  </filter-mapping>
</web-app>
